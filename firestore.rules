rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list identical to VITE_ADMIN_EMAILS in your .env
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['you@example.com'];
    }
    function signedIn() { return request.auth != null; }

    // Predictions are locked when config/settings.locked == true (admins bypass).
    function locked() {
      return exists(/databases/$(database)/documents/config/settings)
        && get(/databases/$(database)/documents/config/settings).data.locked == true;
    }

    // config/actual (results) + config/settings (lock): everyone reads, admin writes.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Online presence: everyone signed in can read; you only write your own doc.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Admin action log: only admins can read; admins append (no edits/deletes).
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Prediction lists: anyone signed in can read (leaderboard + viewing others).
    // Create/edit your own only while unlocked; admins can always create/edit/delete.
    match /lists/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (isAdmin() || !locked());
      allow update: if signedIn()
        && (isAdmin() || (resource.data.ownerUid == request.auth.uid && !locked()));
      allow delete: if signedIn()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (resource.data.imported == true
              && resource.data.ownerEmail == request.auth.token.email)
        );
    }
  }
}
